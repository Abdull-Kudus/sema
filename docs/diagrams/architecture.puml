@startuml architecture
!theme plain
title Sema — architecture (feature-first, layered)
package "Flutter app (Android / iOS)" {
  [Presentation\nscreens & widgets] as UI
  [Application\nRiverpod providers & notifiers] as APP
  [Domain\nReport, AppUser, enums] as DOM
  [Data\nAuthRepository, ReportRepository,\nPhotoStorage] as DATA
  [go_router\nauth redirect & role guard] as ROUTER
}
cloud "Firebase" {
  [Authentication\nemail verification, Google] as AUTH
  database "Cloud Firestore\n(africa-south1)\n+ security rules" as FS
}
cloud "Supabase" {
  storage "Storage bucket: photos\n+ RLS (Firebase JWT)" as SB
}
UI --> APP : watch / read
ROUTER --> APP : auth state
APP --> DATA
APP --> DOM
DATA --> DOM
DATA --> AUTH : FirebaseAuth
DATA --> FS : streams & batches
DATA --> SB : upload / remove
SB ..> AUTH : verifies Firebase ID token\n(Third-Party Auth)
@enduml
