@startuml erd
!theme plain
hide circle
skinparam linetype ortho
title Sema — Firestore data model
entity "users/{uid}" as users {
  * uid : string <<PK>>
  --
  name : string
  email : string (ALU domain)
  role : student | staff
  photoUrl : string?
  createdAt : timestamp
}
entity "reports/{id}" as reports {
  * id : string <<PK>>
  --
  * reporterId : string <<FK users>>
  title, description : string
  category : enum(8)
  priority : low | medium | high
  location, spot, locationDetail : string
  status : submitted | acknowledged | inProgress | resolved | rejected
  isAnonymous : bool
  photoUrls[], photoPaths[] : string
  upvoterIds[] : string <<FK users>>
  handledBy : string?
  createdAt, updatedAt, resolvedAt : timestamp
}
entity "reports/{id}/updates/{id}" as updates {
  * id <<PK>>
  --
  status : enum
  note : string
  authorId <<FK users>>
  authorName, authorRole : string
  createdAt : timestamp
}
entity "users/{uid}/notifications/{id}" as notes {
  * id <<PK>>
  --
  reportId <<FK reports>>
  title, body : string
  status : enum
  read : bool
  createdAt : timestamp
}
entity "Supabase: photos bucket" as photos {
  reports/{uid}/{reportId}/{ts}.jpg
  avatars/{uid}/avatar.jpg
}
users ||--o{ reports : files
reports ||--|{ updates : history
users ||--o{ notes : receives
reports ||--o{ notes : about
reports ||--o{ photos : photoPaths
users |o--o| photos : avatar
@enduml
